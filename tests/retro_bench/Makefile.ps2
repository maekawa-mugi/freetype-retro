# Standalone PS2 EE build of FreeType's single-TU regression/benchmark.
# This suite has one compilation unit, so -j is supported but cannot
# accelerate that one compile. Keep the output name stable across projects.
.PHONY: all glyph-bench FORCE
all: $(OUT)

$(OUT): $(ROOT)/tests/retro_bench/bench.c $(ROOT)/tests/retro_bench/kernels.h FORCE
	@mkdir -p "$(dir $@)"
	"$(EE_CC)" -O2 -std=c99 -march=r5900 -G0 -D_EE -DRETRO_BENCH_R5900 \
	  "-DRETRO_BENCH_BUILD_ID=\"ps2-r5900-$(BUILD_ID)\"" \
	  -ffunction-sections -fdata-sections \
	  -I"$(PS2SDK)/ee/include" -I"$(PS2SDK)/common/include" \
	  "$(ROOT)/tests/retro_bench/bench.c" \
	  -B"$(CRT_DIR)/" -T"$(PS2SDK)/ee/startup/linkfile" \
	  -L"$(PS2SDK)/ee/lib" -Wl,-zmax-page-size=128,--gc-sections \
	  "-Wl,-Map,$@.map" -Wl,--start-group -ldebug -lc -lcglue -lkernel \
	  -Wl,--end-group -o "$@"

# Link to a prebuilt FreeType archive: run once with each build, with
# identical FT_LIBS and font. OUT must be distinct from freetype_mmi.elf.
glyph-bench:
	@test -n "$(FT_ARCHIVE)" || { echo "Set FT_ARCHIVE to scalar/optimized libfreetype.a" >&2; exit 1; }
	@mkdir -p "$(dir $(OUT))"
	"$(EE_CC)" -O2 -std=c99 -march=r5900 -G0 -D_EE \
	  "-DRETRO_BENCH_BUILD_ID=\"ps2-glyph-$(BUILD_ID)\"" \
	  -I"$(ROOT)/include" -I"$(PS2SDK)/ee/include" -I"$(PS2SDK)/common/include" \
	  "$(ROOT)/tests/retro_glyph_bench.c" "$(FT_ARCHIVE)" $(FT_LIBS) \
	  -B"$(CRT_DIR)/" -T"$(PS2SDK)/ee/startup/linkfile" \
	  -L"$(PS2SDK)/ee/lib" -Wl,-zmax-page-size=128 \
	  -Wl,--start-group -lc -lcglue -lkernel -Wl,--end-group -o "$(OUT)"
